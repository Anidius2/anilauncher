{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AniLauncher",
  "version": "1.0.1",
  "identifier": "dev.anidius.anilauncher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AniLauncher",
        "width": 1280,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://launchercontent.mojang.com https://www.minecraft.net https://textures.minecraft.net https://cdn.modrinth.com data: blob:; font-src 'self' asset: http://asset.localhost data:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUyNkQzQTlDRTZDMkRCODgKUldTSTI4TG1uRHB0VW4yTUhEYUNoRHFZS2EwMlZNSHM3akpBQ1dES2xYcWtlU1VpZGlmVFpHNVkK",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}
